# Copy this file to .env and fill in your values
# NEVER commit .env to git!

VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
VITE_OPENWEATHER_API_KEY=your_openweather_api_key_here
VITE_WINDY_API_KEY=your_windy_api_key_here

# ─── Stripe ─────────────────────────────────────────────────────────────────
# Get keys at https://dashboard.stripe.com/test/apikeys
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Price IDs — create products at https://dashboard.stripe.com/test/products
# Legacy (backward compat)
VITE_STRIPE_PRICE_PREMIUM_MONTHLY=price_...
VITE_STRIPE_PRICE_PREMIUM_ANNUAL=price_...

# New 5-tier pricing
VITE_STRIPE_PRICE_SAILOR_MONTHLY=price_...
VITE_STRIPE_PRICE_SAILOR_ANNUAL=price_...
VITE_STRIPE_PRICE_CAPTAIN_MONTHLY=price_...
VITE_STRIPE_PRICE_CAPTAIN_ANNUAL=price_...
VITE_STRIPE_PRICE_CHARTER_FLEET_MONTHLY=price_...
VITE_STRIPE_PRICE_CHARTER_FLEET_ANNUAL=price_...
VITE_STRIPE_PRICE_AI_ONLY_MONTHLY=price_...
VITE_STRIPE_PRICE_AI_ONLY_ANNUAL=price_...

# White Label Marina subscriptions (recurring monthly)
VITE_STRIPE_PRICE_WL_UP_TO_50=price_YOUR_WL_50_PRICE_ID
VITE_STRIPE_PRICE_WL_OVER_50=price_YOUR_WL_OVER_50_PRICE_ID

# App base URL used in Stripe redirect URLs
VITE_APP_URL=http://localhost:5173

# ─── Supabase Edge Function Secrets (set via Supabase Dashboard, NOT in .env) ─
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...         <- for subscription webhook
# STRIPE_CONNECT_WEBHOOK_SECRET=whsec_... <- for Connect/booking webhook
# STRIPE_PRICE_PREMIUM_MONTHLY=price_...
# STRIPE_PRICE_PREMIUM_ANNUAL=price_...
# STRIPE_PRICE_SAILOR_MONTHLY=price_...
# STRIPE_PRICE_SAILOR_ANNUAL=price_...
# STRIPE_PRICE_CAPTAIN_MONTHLY=price_...
# STRIPE_PRICE_CAPTAIN_ANNUAL=price_...
# STRIPE_PRICE_CHARTER_FLEET_MONTHLY=price_...
# STRIPE_PRICE_CHARTER_FLEET_ANNUAL=price_...
# STRIPE_PRICE_AI_ONLY_MONTHLY=price_...
# STRIPE_PRICE_AI_ONLY_ANNUAL=price_...
# APP_URL=https://your-production-domain.com
