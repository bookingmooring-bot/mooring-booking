# Meta Ads API credentials — copy to .env and fill in real values
# NEVER commit .env to git

# Business Manager > Ad Accounts > your account ID (format: act_1234567890)
META_AD_ACCOUNT_ID=act_CHANGE_ME

# User Access Token with scopes: ads_management, pages_manage_ads, leads_retrieval
# Get from Graph API Explorer: https://developers.facebook.com/tools/explorer/
# Select MooringAps app, choose "Get User Token", add the scopes, click Generate.
# Token is short-lived (1h) — only needs to survive the ~2min script run.
META_USER_ACCESS_TOKEN=CHANGE_ME

# Numeric Page ID for MooringAps page (NOT the username)
# Find via Graph API Explorer: GET /me/accounts
META_PAGE_ID=CHANGE_ME

# MooringAps FB App ID (already known from previous work)
META_APP_ID=1571638673893958

# FB App Secret (recommended for app-secret-proof signing). Same as in Supabase env.
META_APP_SECRET=CHANGE_ME

# Folder with video and image creatives (from copy deck doc)
# Windows path: C:\Users\Korisnik\Desktop\mooringbooking\ads reklama
# On Windows, use forward slashes or escape backslashes in .env
ASSETS_DIR=C:/Users/Korisnik/Desktop/mooringbooking/ads reklama
