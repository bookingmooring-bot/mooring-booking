# Environment variables - NEVER commit to git!
.env
.env.local
.env.*.local
.env.production
.env.development
.env.staging

# Meta Ads automation — credentials and run outputs
scripts/meta_ads/.env
scripts/meta_ads/output/
scripts/meta_ads/__pycache__/
scripts/meta_ads/**/__pycache__/

# MCP config with tokens - NEVER commit to git!
.mcp.json

# Claude Code local settings (may contain tokens inside allow-list) - NEVER commit!
.claude/settings.local.json

# Ad-hoc Meta API dumps (contain lead PII) - NEVER commit!
_adsets.json
_leadforms.json
_leads_*.json
_meta_insights_all.json
_pages.json

# Tokens and credentials files
token.json

# One-time utility scripts with hardcoded keys
scripts/seed-moorings.mjs
scripts/import-marinas.mjs
scripts/backfill-missed-leads.mjs
check_booking.ts
check_db.ts
fix_db.ts

# Data files and reports
*.xlsx
~$*
AUDIT_REPORT.md
LEAD_BACKFILL_REPORT*.md

# Large binary files (videos are in public/videos/ and served from there)
*.mp4

# Supabase temp files
supabase/.temp/

# Sea-route graphs are stored in the DB (sea_route_graph table), uploaded by
# scripts/searoute/upload-region-graph.mjs. The build dir keeps the gz + meta for
# reproducibility; the large uncompressed graph JSON is a throwaway build artifact.
scripts/searoute/build/*.graph.json

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
